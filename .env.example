# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required
ASSEMBLYAI_API_KEY=
# Your own consented cloned voice, created in the AssemblyAI dashboard (US data zone)
KAVACH_WARNING_VOICE_ID=
# From @BotFather; then message the bot once and run: uv run python scripts/check_keys.py --find-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown)
# LANGUAGE=english
# STT_MODEL=universal-3-6-pro
# STT_MODE=balanced
# DETECTOR_MODEL=qwen3.5-4b-32k-fast
# DETECTOR_FALLBACK_MODEL=gemma-4-31b
# PERSONA_MODEL=qwen3.5-4b-32k-fast
# SCRIPT_GEN_MODEL=gemma-4-31b
# PERSONA_VOICE_ID=aai-gunnar
# RISK_THRESHOLD=70
# PARENT_ADDRESS=Papa
# FAMILY_MEMBER_NAME=your son
