{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kavach",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "kavach-app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}