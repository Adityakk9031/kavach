{
  "expo": {
    "name": "Kavach",
    "slug": "kavach",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kavach.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kavach listens to the call to spot scams and carries your voice to the other phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f6f5c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kavach.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "READ_PHONE_STATE",
        "ANSWER_PHONE_CALLS",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15171a"
    },
    "plugins": [
      "./plugins/withKavachListener"
    ],
    "extra": {
      "eas": {
        "projectId": "6bdebe19-8509-44a8-b801-ac361af2be36"
      }
    },
    "owner": "sfzsdfs"
  }
}
